# Server Configuration
PORT=4000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=multiDocDB

# Document Processing & Upload Limits
MAX_FILE_SIZE_MB=10

# AI Provider Configuration (supports 'mock' or real LLM keys)
AI_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
